{
  "root": {
    "currentUser": {
      "type": "User",
      "persistenceLevel": "session"
    },
    "company": {
      "type": "oneToMany defining Company",
      "persistenceLevel": "cloud"
    },
    "drivers": {
      "type": "oneToMany defining User",
      "persistenceLevel": "cloud"
    },
    "clients": {
      "type": "oneToMany defining Client",
      "persistenceLevel": "cloud"
    },
    "deliveries": {
      "type": "oneToMany defining Delivery",
      "persistenceLevel": "cloud"
    },
    "tankShapes": {
      "type": "oneToMany defining TankShape",
      "persistenceLevel": "device"
    },
    "fuelTypes": {
      "type": "oneToMany defining FuelType",
      "persistenceLevel": "device"
    }
  },
  "typeRepository": {
    "User": {
      "id": {
        "type": "string",
        "defaultValue": "''"
      },
      "username": {
        "type": "string",
        "defaultValue": "''"
      },
      "password": {
        "type": "string",
        "defaultValue": "''"
      },
      "role": {
        "type": "string",
        "defaultValue": "'driver'"
      }
    },
    "Company": {
      "id": {
        "type": "string",
        "defaultValue": "''"
      },
      "name": {
        "type": "string",
        "defaultValue": "''"
      }
    },
    "Client": {
      "id": {
        "type": "string",
        "defaultValue": "''"
      },
      "name": {
        "type": "string",
        "defaultValue": "''"
      },
      "uniqueNumber": {
        "type": "string",
        "defaultValue": "''"
      },
      "fuelHistory": {
        "type": "oneToMany FuelRecord",
        "defaultValue": "[]"
      }
    },
    "Delivery": {
      "id": {
        "type": "string",
        "defaultValue": "''"
      },
      "clientId": {
        "type": "string",
        "defaultValue": "''"
      },
      "driverId": {
        "type": "string",
        "defaultValue": "''"
      },
      "fuelType": {
        "type": "string",
        "defaultValue": "''"
      },
      "amount": {
        "type": "number",
        "defaultValue": "0"
      },
      "date": {
        "type": "Date",
        "defaultValue": "new Date()"
      }
    },
    "TankShape": {
      "id": {
        "type": "string",
        "defaultValue": "''"
      },
      "name": {
        "type": "string",
        "defaultValue": "''"
      },
      "calculationFormula": {
        "type": "string",
        "defaultValue": "''"
      }
    },
    "FuelType": {
      "id": {
        "type": "string",
        "defaultValue": "''"
      },
      "name": {
        "type": "string",
        "defaultValue": "''"
      },
      "density": {
        "type": "number",
        "defaultValue": "0"
      }
    },
    "FuelRecord": {
      "id": {
        "type": "string",
        "defaultValue": "''"
      },
      "deliveryId": {
        "type": "string",
        "defaultValue": "''"
      },
      "fuelType": {
        "type": "string",
        "defaultValue": "''"
      },
      "amount": {
        "type": "number",
        "defaultValue": "0"
      },
      "date": {
        "type": "Date",
        "defaultValue": "new Date()"
      }
    }
  }
}
